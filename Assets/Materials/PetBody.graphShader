        ScriptName:
          String: vertexShadingAmount
        SortIndex:
          Variable: 1
        Step:
          Variable: 0.009999999776482582
        Title:
          String: Vertex Shading
        Tooltip:
          String: How strongly the mesh's baked vertex colors darken the body. 0 ignores them, 1 applies them fully.
      PositionX: -380
      PositionY: 180
      TemplateID: nodes_inputs_parameters_float
      Title1: Float Parameter
      Title2: Vertex Shading
    Node2:
      DependencyIndex: 2
      LevelID: 0
      NodeCount: 0
      NodeType: 1
      Ports:
        BaseColor:
          Connection0:
            NodeLevelID: 1
            PortID: Output
          Variable: [1.0, 1.0, 1.0, 1.0]
        Code:
          ClassType1: TEXT
          String: |-
            // Unlit body shader for the ready-made pet meshes.
            //
            // The meshes carry a baked COLOR_0 gradient (darker feet/underside,
            // lighter back and head) produced by Tools/bake-vertex-shading.js.
            // Multiplying it into the identity color is what makes the creatures
            // read as volumes instead of flat cutouts, and it costs nothing:
            // no lighting, no extra texture fetch, just an interpolated vertex
            // attribute the mesh already carries.
            input_vec4 BaseColor;
            input_float ShadingAmount;
            input_float Urgency;
            input_float RimGain;
            input_float RimPower;
            input_float DissolveAmount;
            input_float DissolveDirection;
            input_float DissolveEdgeGain;
            input_float DissolveHeightCm;
            output_vec4 Result;

            // ---- Dissolve tuning that is not worth an Inspector row --------
            // Edge band thickness as a fraction of body height. 0.06 of a ~40cm
            // creature is ~2.5cm, which is the "few centimetres" the beat wants.
            const float DISSOLVE_EDGE = 0.06;
            // Noise frequency in object-space cm, and how far it displaces the
            // front. Amplitude is in the same normalised height units as the
            // threshold, so 0.10 lets the front wander a tenth of the body.
            const float DISSOLVE_NOISE_SCALE = 0.18;
            const float DISSOLVE_NOISE_AMP = 0.10;

            // Value noise. Procedural because the pipeline discards textures on
            // these meshes — the same constraint that forced the vertex-colour
            // bake. Hash-based, so it costs arithmetic and no bandwidth.
            float dissolveHash(vec3 p)
            {
            	p = fract(p * 0.3183099 + vec3(0.71, 0.113, 0.419));
            	p += dot(p, p.yzx + 19.19);
            	return fract((p.x + p.y) * p.z);
            }

            float dissolveNoise(vec3 x)
            {
            	vec3 i = floor(x);
            	vec3 f = fract(x);
            	// Smoothstep weights: a linear blend would show the lattice as
            	// visible diamonds along the front.
            	f = f * f * (3.0 - 2.0 * f);
            	float n000 = dissolveHash(i + vec3(0.0, 0.0, 0.0));
            	float n100 = dissolveHash(i + vec3(1.0, 0.0, 0.0));
            	float n010 = dissolveHash(i + vec3(0.0, 1.0, 0.0));
            	float n110 = dissolveHash(i + vec3(1.0, 1.0, 0.0));
            	float n001 = dissolveHash(i + vec3(0.0, 0.0, 1.0));
            	float n101 = dissolveHash(i + vec3(1.0, 0.0, 1.0));
            	float n011 = dissolveHash(i + vec3(0.0, 1.0, 1.0));
            	float n111 = dissolveHash(i + vec3(1.0, 1.0, 1.0));
            	float nx00 = mix(n000, n100, f.x);
            	float nx10 = mix(n010, n110, f.x);
            	float nx01 = mix(n001, n101, f.x);
            	float nx11 = mix(n011, n111, f.x);
            	return mix(mix(nx00, nx10, f.y), mix(nx01, nx11, f.y), f.z);
            }

            void main()
            {
            	vec4 vertexColor = system.getSurfaceColor();
            	float amount = clamp(ShadingAmount, 0.0, 1.0);
            	// Meshes with no COLOR_0 read as black here, which would make the
            	// body vanish on an additive display. Blending from white rather
            	// than multiplying raw keeps amount = 0 an exact no-op, so the
            	// failure mode is "unshaded" instead of "invisible".
            	vec3 shade = mix(vec3(1.0), vertexColor.rgb, amount);
            	vec3 body = BaseColor.rgb * shade;
            	
            	// ---- Urgency as LIGHT, not paint -------------------------------
            	// The SPECS display is additive: rendered content adds light over
            	// passthrough. Blending red into the base colour fought identity —
            	// at the first values a chasing yellow read identically to a calm
            	// amber. This channel ADDS the creature's OWN hue instead, so the
            	// palette entry survives at every urgency level; only its intensity
            	// changes.
            	//
            	// EVERY term below is multiplied by u, so u = 0.0 is an exact
            	// mathematical no-op (emissive == vec3(0.0)) and Result is
            	// bit-identical to the pre-existing shader. That is deliberate: a
            	// previous graph edit silently rendered every body black with no
            	// compile error, so the calm case must be provably unchanged.
            	float u = clamp(Urgency, 0.0, 1.0);
            	
            	// Rim: camera-space normals, so a surface turned away from the
            	// viewer glows at its silhouette. abs() makes this independent of
            	// the z sign convention and of back-facing triangles (the body
            	// material is two-sided).
            	vec3 nCam = normalize(system.getSurfaceNormalCameraSpace());
            	float facing = clamp(abs(nCam.z), 0.0, 1.0);
            	// RimPower is designer-editable, so guard the degenerate case: pow(x, 0)
            	// is 1.0 everywhere, which would flood the whole body instead of its
            	// silhouette. A freshly added parameter also arrives as 0.
            	float rimPower = max(RimPower, 0.25);
            	float rim = pow(1.0 - facing, rimPower);
            	
            	// Pulse: rate AND depth rise with urgency. Capped at 0.85 Hz, well
            	// under the 1.5 Hz where a pulse starts reading as flicker, and far
            	// from the 3-5 Hz tremor channels that were deliberately removed for
            	// looking anxious rather than alive.
            	float hz = mix(0.22, 0.85, u);
            	float wave = 0.5 + 0.5 * sin(system.getTimeElapsed() * hz * 6.2831853);
            	float pulse = mix(1.0, wave, 0.55 * u);
            	
            	// Emissive is the identity colour scaled, never a foreign hue.
            	vec3 emissive = body * rim * max(RimGain, 0.0) * pulse * u;

            	// ---- Dissolve / spawn ------------------------------------------
            	// One channel drives both beats. DissolveAmount is "how gone the
            	// body is": 0 = whole, 1 = absent. Release runs it 0 -> 1, spawn
            	// runs it 1 -> 0, so BOTH beats end at 0 and 0 means "fully
            	// present" in either direction.
            	//
            	// The entire effect sits behind `a > 0.0` for two reasons. First
            	// safety: a previous graph edit rendered every body silently
            	// black, so the untouched case must be provably untouched — with
            	// a == 0.0 not one line below executes and Result is
            	// bit-identical to the shader before this block existed. Second
            	// cost: `discard` forces a fragment shader to defer depth writes
            	// and disables early-z for the whole draw. Gating it on a uniform
            	// means only a creature actually mid-effect pays, and only for
            	// the second or so it is running — the other five keep the fast
            	// path. That matters here because pooling brought the release
            	// frame from 551ms to 224ms and a blanket discard would hand
            	// that back.
            	float a = clamp(DissolveAmount, 0.0, 1.0);
            	if (a > 0.0)
            	{
            		// Object-space height, derived from the model matrix rather
            		// than a texture or a second UV set. getSurfacePosition() is
            		// WORLD space (it is compared against getCameraPosition()
            		// elsewhere), so project the offset from the object's origin
            		// onto its own up axis and divide out world scale. This keeps
            		// the sweep tied to the body while the creature walks,
            		// breathes and squashes — a world-space threshold would slide
            		// down the creature as it moved.
            		mat4 model = system.getMatrixWorld();
            		vec3 originW = model[3].xyz;
            		vec3 upW = model[1].xyz;
            		float upLen = max(length(upW), 1e-4);
            		float localCm = dot(system.getSurfacePosition() - originW, upW / upLen) / upLen;
            		float height = max(DissolveHeightCm, 1.0);
            		float h = clamp(localCm / height, 0.0, 1.0);

            		// Break the waterline into an organic front. Noise is sampled
            		// in object space so the pattern is welded to the body and
            		// does not swim while the creature moves.
            		vec3 noisePos = (system.getSurfacePosition() - originW) / upLen;
            		float n = dissolveNoise(noisePos * DISSOLVE_NOISE_SCALE);
            		float hn = h + (n - 0.5) * DISSOLVE_NOISE_AMP;

            		// Direction picks which side survives, and both sweep UPWARD:
            		//   +1 release  threshold = a      keep above  (eaten bottom-up)
            		//   -1 spawn    threshold = 1 - a  keep below  (fills bottom-up)
            		// An unset/zero parameter falls back to release rather than to
            		// a degenerate 0 comparison.
            		float dir = (DissolveDirection < 0.0) ? -1.0 : 1.0;
            		float threshold = (dir > 0.0) ? a : (1.0 - a);
            		float signedDist = (hn - threshold) * dir;
            		if (signedDist < 0.0) discard;

            		// The band at the front. On an additive display added light IS
            		// the medium, so the reward reads as emission rather than as
            		// a colour change: the creature's own palette entry pushed
            		// most of the way to white, so identity survives while the
            		// band still blooms.
            		float edge = 1.0 - smoothstep(0.0, DISSOLVE_EDGE, signedDist);
            		vec3 edgeColor = mix(BaseColor.rgb, vec3(1.0), 0.75);
            		emissive += edgeColor * edge * max(DissolveEdgeGain, 0.0);
            	}

            	Result = vec4(body + emissive, BaseColor.a);
            }
